* text=auto

# Keep source and metadata stable across Windows and Linux development.
*.py text eol=lf
*.cu text eol=lf
*.jl text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cff text eol=lf
*.txt text eol=lf
*.in text eol=lf
*.csv text eol=lf

# Generated media are binary and must not undergo line-ending conversion.
*.png binary
*.gif binary
*.mp4 binary
*.avi binary
*.mov binary
